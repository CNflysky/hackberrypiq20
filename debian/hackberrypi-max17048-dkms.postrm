#!/bin/sh
set -e
CONFIG_TXT="/boot/firmware/config.txt"
OVERLAY_DIR="/boot/firmware/overlays"
OVERLAY_NAME="hackberrypicm5.dtbo"
DT_NAME="hackberrypicm5"

echo "Cleaning up..."
rm -f ${OVERLAY_DIR}/${OVERLAY_NAME} /usr/share/keyrings/hackberrypi-max17048.gpg /etc/apt/sources.list.d/hackberrypi-max17048.sources
sed -i "\|^dtoverlay=${DT_NAME}$|d" "${CONFIG_TXT}"
exit 0
